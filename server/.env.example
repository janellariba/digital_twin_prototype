# Copy this file to .env and fill in your own values. .env is never committed.

# PostgreSQL connection (psycopg 3 driver).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Use 127.0.0.1 instead of localhost on Windows (avoids slow IPv6 lookups).
DATABASE_URL=postgresql+psycopg://aisunog_dt:CHANGE_ME@127.0.0.1:5432/aisunog_dt

# Shared secret for camera nodes. Use the same value in camera_node/.env.
# Make one with:  python -c "import secrets; print(secrets.token_hex(16))"
NODE_API_KEY=CHANGE_ME

# Optional overrides (defaults shown)
# WATCHTOWERS_FILE=config/watchtowers.json
# SIMULATION_FILE=config/simulation.json
# CRS_EPSG=32651
# MONITORING_FILE=config/monitoring.json
# STORAGE_DIR=storage
